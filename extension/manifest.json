{
  "manifest_version": 3,
  "name": "Mnet Plus Subtitle Downloader",
  "version": "0.1.0",
  "description": "Detect available Mnet Plus subtitle tracks and export selected tracks as SRT.",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": [
    "https://mnetplus.world/*",
    "https://api.mnetplus.world/*"
  ],
  "action": {
    "default_title": "Mnet Plus Subtitle Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mnetplus.world/media/*/videos/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
